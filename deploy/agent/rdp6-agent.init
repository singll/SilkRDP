#!/bin/sh /etc/rc.common
# ==============================================================================
# rdp6-agent - OpenWrt / iStoreOS procd 服务
# 安装到 /etc/init.d/rdp6-agent，并 chmod 0755。
# 运行前请确认：
#   - /opt/rdp6-agent/rdp6-agent 已安装；
#   - /opt/rdp6-agent/token 存在且权限 0600；
#   - Tailscale 已在该接口上就绪（RDP6_LISTEN 使用 Tailscale 地址）。
# ==============================================================================

START=95
STOP=10
USE_PROCD=1

start_service() {
    local token
    token="$(cat /opt/rdp6-agent/token 2>/dev/null || true)"
    [ -n "$token" ] || {
        logger -t rdp6-agent "missing /opt/rdp6-agent/token"
        return 1
    }

    procd_open_instance
    procd_set_param command /opt/rdp6-agent/rdp6-agent
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_set_param env \
        RDP6_LISTEN="100.64.0.2:8091" \
        RDP6_WIN10_MAC="AA:BB:CC:DD:EE:FF" \
        RDP6_LAN_IF="br-lan" \
        RDP6_HOSTID="129" \
        RDP6_RDP_PORT="3389" \
        RDP6_TTL="180" \
        RDP6_NFT_SET="rdp6_open" \
        RDP6_TOKEN="$token" \
        RDP4_NFT_SET="rdp4_clients" \
        RDP4_EXT_PORT="33891" \
        RDP4_WAN_IFACE="wan" \
        RDP4_TTL="300" \
        RDP4_REFRESH="60"

    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "network"
}
