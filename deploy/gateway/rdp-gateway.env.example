# ==============================================================================
# rdp-gateway 环境变量
# 复制到 /etc/rdp-gateway.env，权限 0640 root:root
# 所有 CHANGE_ME / 示例地址都必须按实际环境替换。
# ==============================================================================

# --- 必填 ---
# 授权页监听地址（只监听回环，由 Caddy 反代）
GW_HTTP_LISTEN=127.0.0.1:8090
# TCP/UDP 中转监听地址（公网入口）
GW_PROXY_LISTEN=0.0.0.0:33890
# 内网目标机 RDP 地址
GW_TARGET=192.168.1.100:3389
# 对外展示的中转地址（客户端实际连接地址）
GW_PUBLIC_ADDR=203.0.113.10:33890
# 家侧 agent 的 v6 开窗接口
GW_AGENT_URL=http://100.64.0.2:8091/open
# 家侧 agent 的 v4 开窗接口
GW_AGENT_V4_URL=http://100.64.0.2:8091/open4
# Authelia 登录页（授权页倒计时结束后的跳转目标）
GW_LOGIN_URL=https://auth.example.com/
# 与家侧 agent 共享的 token（请使用高强度随机串）
RDP6_TOKEN=CHANGE_ME_long_random_token

# --- 可选 ---
# nft 表/集合名（与 deploy/gateway/rdp_guard.nft 保持一致）
GW_NFT_SET=rdp_guard
GW_NFT_BIN=/usr/sbin/nft
# 中转/直连开窗 TTL（秒）
GW_TTL=180
# UDP 会话空闲回收（秒）
GW_UDP_IDLE=1800
# 长期白名单持久化文件
GW_STATE_FILE=/var/lib/rdp-gateway/state.json
# 历史记录条数
GW_HISTORY_LIMIT=160
# 长期白名单刷新周期（秒）；不填则取 max(20, GW_TTL/2)
GW_PERMANENT_REFRESH=90
